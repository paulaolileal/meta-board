# Google Sheets spreadsheet ID that hosts the meta-board data (from the sheet's
# URL: https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit).
SPREADSHEET_ID=

# Absolute path to the Service Account JSON key file. Keep this OUTSIDE the
# repo (e.g. C:\Users\<you>\.secrets\meta-board-mcp-sa.json) — never commit it.
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=
